# Local-only HTTPS preflight template. Owner must supply an already browser-trusted
# certificate whose SAN includes DNS:localhost. No certificate or trust-store
# changes are performed by this project. Do not publish or expose this listener.

server {
    listen 127.0.0.1:8443 ssl;
    listen [::1]:8443 ssl;
    server_name localhost;

    ssl_certificate     __TRUSTED_LOCALHOST_CERTIFICATE_PATH__;
    ssl_certificate_key __LOCALHOST_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 4k;

    location / {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://127.0.0.1:4242;
        proxy_http_version 1.1;
        # Required: HPP_PUBLIC_ORIGIN is https://localhost:8443, and the
        # backend checks Host against parsed.host including this port.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        # The backend may use 30s auth + 30s GET before responding.
        proxy_read_timeout 70s;
        proxy_intercept_errors off;
        proxy_next_upstream off;
    }
}
