# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.
# Keys: sandbox web app (https://www.sandbox.airwallex.com/app/) > Account > Developer > API keys.

AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# Only for a scoped key linked to multiple accounts. The target account ID is local-only;
# verify it against the selected US sandbox account before use. Sent only on authentication.
AIRWALLEX_LOGIN_AS=

# Sandbox REST host. Verified 2026-10-11 against the API reference introduction and the
# sandbox environment overview: https://api.sandbox.airwallex.com (production is api.airwallex.com).
# Only the documented api.sandbox.airwallex.com host is accepted; no arbitrary demo host or production endpoint.
AIRWALLEX_BASE=https://api.sandbox.airwallex.com

# File service host for evidence uploads (Upload a File API reference, builder guide kit 4).
AIRWALLEX_FILES_BASE=https://files.sandbox.airwallex.com

# Secret shown for your webhook notification URL in the web app (used by src/webhook.ts).
WEBHOOK_SECRET=
